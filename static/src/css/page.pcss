/**
 * We use:
 * - CSS grid and flexbox
 * - tailwindcss
 * - rem for HTML element size (as opposed to px or em)
 * - "-" to separate words in class names
 */

@tailwind base;
@tailwind components;
@tailwind utilities;

.page-grid {
    display: grid;
    grid-gap: 0.2rem;
    /* min-height, not height: content taller than the viewport has to grow the
       grid instead of spilling out over the footer. dvh keeps the mobile URL
       bar from covering the last row; browsers without it ignore the line. */
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
}

@media only screen and (min-width: 1025px) {
    .page-grid {
        grid-template-areas:
            "header header header"
            "article article article"
            "footer footer footer";
        grid-template-rows: auto 1fr auto;
        grid-template-columns: repeat(3, 1fr);
    }
}

@media only screen and (max-width: 1024px) {
    .page-grid {
        grid-template-areas:
            "header"
            "article"
            "footer";
        grid-template-rows: auto 1fr auto;
        grid-template-columns: 1fr;
    }
}

footer, article {
    padding: 0.5rem;
}

header {
    grid-area: header;
}

article {
    grid-area: article;
}

footer {
    grid-area: footer;
}

footer > span {
    padding: 0rem 0.3rem;
}

.ham_icon {
    width: 4em;
}

.side-quiz-container {
    width: 24rem;
}

.gc_menu_icon {
    height: 2em;
}

.btn-gradient {
    --btn-bg-color: #7c3aed;
    background-image: linear-gradient(to bottom right, #A02BE4, transparent, #4f46e5);
}

.wider-analyzed-part {
    min-width: 10em;
}

.ai-analysis-panel {
    background-image: linear-gradient(to right, #7c3aed, #2563eb);
}

.ai-analysis-panel:hover {
    opacity: 0.9;
}

/**
 * The YouTube player in the watch app: a 16:9 box that follows the column
 * width, but never grows so tall that the subtitles under it need scrolling.
 */
.watch-video-box {
    position: relative;
    width: 100%;
    max-width: calc(55vh * 16 / 9);
}

.watch-video-box::before {
    content: "";
    display: block;
    padding-bottom: 56.25%;
}

/* The IFrame API replaces the div with an iframe carrying the same id, so
   this rule covers the box before and after the player boots. */
#watch_player {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}